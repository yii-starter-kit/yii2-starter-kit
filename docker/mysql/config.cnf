[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
init-connect='SET NAMES utf8mb4'
collation_server=utf8mb4_unicode_ci
character_set_server=utf8mb4
# MySQL 8.4 removed skip-character-set-client-handshake and default_authentication_plugin.
# caching_sha2_password (the 8.4 default) is supported by PHP's mysqlnd driver.
