# Autodetect text files
* text=auto
*.sh text eol=lf

# ...Unless the name matches the following overriding patterns

# Definitively text files
*.php  text
*.css  text
*.js   text
*.txt  text
*.md   text
*.xml  text
*.json text
*.bat  text
*.sql  text
*.xml  text
*.yml  text
# Ensures that on windows sh files won't have CR LF that breaks docker-compose
*.sh   text eol=lf

# Ensure those won't be messed up with
*.png  binary
*.jpg  binary
*.gif  binary
*.ttf  binary

# Ignore repository tooling for archive. The docs ship with the package so the
# README links keep working after `composer create-project`.
/.gitattributes         export-ignore
